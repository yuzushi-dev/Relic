{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://relic-oss.dev/schemas/data-model/sensitive_signal.schema.json",
  "title": "Sensitive Signal",
  "description": "Schema for PR32 sensitive pattern/safety signal records. Researcher-facing only.",
  "type": "object",
  "required": ["signal_id", "subject_id", "gumi_instance_id", "hermes_profile_id", "signal_type", "detected_at", "researcher_visible"],
  "properties": {
    "signal_id": {
      "type": "string",
      "description": "Unique signal identifier"
    },
    "subject_id": {
      "type": "string",
      "description": "Subject scope identifier"
    },
    "gumi_instance_id": {
      "type": "string",
      "description": "Gumi instance scope identifier"
    },
    "hermes_profile_id": {
      "type": "string",
      "description": "Hermes profile scope identifier"
    },
    "signal_type": {
      "type": "string",
      "description": "Type of sensitive pattern detected"
    },
    "signal_category": {
      "type": "string",
      "enum": [
        "crisis_self_harm",
        "privacy_boundary",
        "output_safety",
        "food_body_context",
        "sleep_context",
        "substance_context",
        "attachment_dependency_context",
        "habit_context",
        "interaction_boundary",
        "high_stakes_context",
        "health_context"
      ],
      "description": "Non-clinical governance category"
    },
    "warning_tier": {
      "type": "string",
      "enum": ["T0_audit", "T1_context", "T2_review", "T3_interruptive", "T4_crisis"],
      "description": "Governance tier, not a clinical risk score"
    },
    "disposition": {
      "type": "string",
      "enum": ["queued", "batched", "reviewed", "dismissed", "policy_patch_created", "notified", "suppressed_noise"],
      "description": "Researcher workbench disposition"
    },
    "evidence_sensitivity": {
      "type": "string",
      "enum": ["redacted_ref_only", "summary_only", "internal_snippet_allowed"],
      "description": "How evidence may be displayed"
    },
    "evidence_refs": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1,
      "description": "Redacted evidence references only; raw text is forbidden"
    },
    "detected_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp"
    },
    "researcher_visible": {
      "type": "boolean",
      "const": true,
      "description": "Always true - researcher-only visibility"
    },
    "subject_visible": {
      "type": "boolean",
      "const": false,
      "description": "Always false - not visible to subject"
    },
    "gumi_visible": {
      "type": "boolean",
      "const": false,
      "description": "Always false - not visible to Gumi"
    },
    "clinical_interpretation_allowed": {
      "type": "boolean",
      "const": false,
      "description": "Always false - no clinical interpretation"
    },
    "patch_applied": {
      "type": "object",
      "description": "Behavior policy patch applied with label stripping",
      "properties": {
        "patch_delta": { "type": "string" },
        "labels_stripped": { "type": "boolean", "const": true },
        "audit_event_id": { "type": "string" }
      }
    }
  },
  "additionalProperties": false
}
