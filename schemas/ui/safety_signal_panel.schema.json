{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://relic-oss.dev/schemas/ui/safety_signal_panel.schema.json",
  "title": "Safety Signal Panel Row",
  "description": "Schema for a single safety signal row in the researcher UI panel",
  "type": "object",
  "required": ["signal_id", "subject_id", "signal_status", "evidence_refs", "confidence", "allowed_adaptations"],
  "properties": {
    "signal_id": {
      "type": "string",
      "description": "Unique signal identifier"
    },
    "subject_id": {
      "type": "string",
      "description": "Subject identifier for scope"
    },
    "signal_status": {
      "type": "string",
      "enum": ["pending", "approved", "rejected", "expired"],
      "description": "Current signal status"
    },
    "signal_category": {
      "type": "string",
      "enum": [
        "crisis_self_harm",
        "privacy_boundary",
        "output_safety",
        "food_body_context",
        "sleep_context",
        "substance_context",
        "attachment_dependency_context",
        "habit_context",
        "interaction_boundary",
        "high_stakes_context",
        "health_context"
      ],
      "description": "Non-clinical governance category"
    },
    "warning_tier": {
      "type": "string",
      "enum": ["T0_audit", "T1_context", "T2_review", "T3_interruptive", "T4_crisis"],
      "description": "Governance tier, not a clinical risk score"
    },
    "disposition": {
      "type": "string",
      "enum": ["queued", "batched", "reviewed", "dismissed", "policy_patch_created", "notified", "suppressed_noise"],
      "description": "Researcher workbench disposition"
    },
    "review_mode": {
      "type": "string",
      "enum": ["audit_only", "context_queue", "batchable", "interruptive", "crisis"],
      "description": "Whether the item is batchable or interrupts researcher workflow"
    },
    "evidence_refs": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Redacted evidence references visible to researcher"
    },
    "evidence_sensitivity": {
      "type": "string",
      "enum": ["redacted_ref_only", "summary_only", "internal_snippet_allowed"],
      "description": "How evidence may be displayed"
    },
    "baseline_comparison": {
      "type": "object",
      "description": "Baseline comparison data",
      "properties": {
        "baseline_confidence": {"type": "number"},
        "current_confidence": {"type": "number"},
        "delta": {"type": "number"}
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 0.85,
      "description": "Confidence capped at 0.85"
    },
    "allowed_adaptations": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Adaptations researcher can approve"
    },
    "forbidden_disclosures": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Disclosures that must not reach subject or Gumi"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
