{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://relic-oss.dev/schemas/ui/consent_record/v1",
  "title": "Subject Consent Record",
  "type": "object",
  "required": [
    "schema_version",
    "active_elicitation",
    "generated_images",
    "generated_audio",
    "generated_music",
    "delivery",
    "recorded_at",
    "recorded_by_researcher_id",
    "consent_version"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string", "const": "1.0.0" },
    "active_elicitation": { "type": "boolean" },
    "generated_images": { "type": "boolean" },
    "generated_audio": { "type": "boolean" },
    "generated_music": { "type": "boolean" },
    "delivery": { "type": "boolean" },
    "recorded_at": { "type": "string", "format": "date-time" },
    "recorded_by_researcher_id": { "type": "string" },
    "consent_version": { "type": "string" }
  }
}
