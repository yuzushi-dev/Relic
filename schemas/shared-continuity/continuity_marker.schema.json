{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://relic.local/schemas/shared-continuity/continuity_marker.schema.json",
  "title": "Continuity Marker",
  "description": "User-confirmed continuity marker with subject scope.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "marker_id", "subject_id", "gumi_instance_id",
    "hermes_profile_id", "subject_confirmation", "source_type", "created_at",
    "subject_words", "status"
  ],
  "properties": {
    "schema_version": {"type": "string"},
    "marker_id": {"type": "string", "minLength": 1},
    "subject_id": {"type": "string", "minLength": 1},
    "gumi_instance_id": {"type": "string", "minLength": 1},
    "hermes_profile_id": {"type": "string", "minLength": 1},

    "subject_confirmation": {
      "type": "boolean",
      "description": "Required. Marker stored only if true."
    },
    "source_type": {
      "type": "string",
      "enum": ["user_provided", "user_confirmed", "user_authored"],
      "description": "How the marker was created."
    },
    "created_at": {"type": "string", "format": "date-time"},

    "subject_words": {
      "type": "array",
      "items": {"type": "string"},
      "minItems": 1,
      "description": "Subject's own words, not system inference."
    },
    "gumi_agreed_words": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Gumi's agreed wording (empty until Gumi confirms)."
    },
    "raw_source_text": {
      "type": "string",
      "description": "Raw source text if applicable."
    },

    "status": {
      "type": "string",
      "enum": ["active", "retired", "rejected", "expired"],
      "description": "Marker lifecycle status."
    },
    "gumi_recall_allowed": {
      "type": "boolean",
      "default": true
    },

    "recall_count": {
      "type": "integer",
      "minimum": 0,
      "default": 0
    },
    "max_recall_count": {
      "type": "integer",
      "minimum": 1,
      "default": 3
    },
    "ttl_seconds": {
      "type": "integer",
      "minimum": 1,
      "default": 604800,
      "description": "Default 7 days."
    },

    "expires_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"}
  },
  "if": {
    "properties": {"status": {"const": "active"}}
  },
  "then": {
    "properties": {
      "subject_confirmation": {"const": true}
    }
  }
}