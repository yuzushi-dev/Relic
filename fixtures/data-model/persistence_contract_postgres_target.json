  "transformation_steps": [
    "1. Export SQLite data to JSON",
    "2. Create PostgreSQL schema with UUID primary keys",
    "3. Transform TEXT fields to UUID/VARCHAR/TIMESTAMPTZ",
    "4. Import data with FK validation enabled",
    "5. Verify row counts match between SQLite and PostgreSQL"
  ],
  "rollback_procedure": [
    "1. Export PostgreSQL data to JSON",
    "2. Disable FK constraints temporarily",
    "3. Drop PostgreSQL tables",
    "4. Recreate SQLite schema",
    "5. Import JSON data",
    "6. Re-enable FK constraints"
  ],
