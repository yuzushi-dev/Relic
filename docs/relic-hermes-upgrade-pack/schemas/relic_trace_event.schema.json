{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yuzushi-dev.github.io/Relic/schemas/relic_trace_event.schema.json",
  "title": "RelicTraceEvent (adapter-payload shape)",
  "$comment": "FORWARD-TARGET / DIVERGENT. Authoritative trace event schema is relic/chronicle/schema.py::Event (Pydantic), which is FLAT and persisted via dual-write JSONL+SQLite (migrations 0003-0007). This file describes the PROPOSED PAYLOAD STRUCTURE for Chronicle events emitted by relic/hermes_adapter/* modules: the nested 'source/hermes/subject/policy/context/decision/redaction' objects below are intended to live inside the Chronicle Event.payload field. To use this as a real contract, regenerate it from the Pydantic model and re-nest adapter-specific keys under Event.payload. See docs/01-upgrade-proposal.md and docs/03-contracts-and-schemas.md in the upgrade pack.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "trace_id",
    "event_type",
    "timestamp",
    "source",
    "hermes",
    "subject",
    "redaction",
    "payload_hash"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "relic.trace.v1"
    },
    "event_id": {
      "type": "string",
      "minLength": 8
    },
    "trace_id": {
      "type": "string",
      "minLength": 8
    },
    "parent_event_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "event_type": {
      "type": "string",
      "enum": [
        "runtime_received",
        "identity_resolved",
        "tool_call_observed",
        "approval_requested",
        "approval_resolved",
        "source_policy_checked",
        "context_pack_requested",
        "context_item_admitted",
        "context_item_blocked",
        "context_pack_rendered",
        "handoff_requested",
        "handoff_allowed",
        "handoff_blocked",
        "delivery_decision_made",
        "llm_call_prepared",
        "llm_output_received",
        "llm_output_reviewed",
        "output_rewritten",
        "output_silenced",
        "output_passed",
        "evidence_observed",
        "signal_extracted",
        "profile_snapshot_created",
        "correction_requested",
        "correction_applied",
        "correction_rejected",
        "observability_export_requested",
        "observability_exported",
        "observability_export_blocked"
      ]
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "platform",
        "source_class"
      ],
      "properties": {
        "platform": {
          "type": [
            "string",
            "null"
          ]
        },
        "channel_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "sender_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_class": {
          "type": "string",
          "enum": [
            "USER_DIRECT_MESSAGE",
            "USER_EXPLICIT_CORRECTION",
            "USER_APPROVAL",
            "USER_REACTION_TO_GUMI",
            "GUMI_DIEGETIC_EVENT",
            "GUMI_GENERATED_MEDIA",
            "SYSTEM_EVENT",
            "TOOL_OUTPUT",
            "PUBLIC_WEB_SOURCE",
            "SCHEDULED_WATCHER_SOURCE"
          ]
        }
      }
    },
    "hermes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "session_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "chat_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "profile_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "tool_call_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "turn_index": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "subject_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "gumi_instance_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "hermes_profile_ref": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "policy_snapshot_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "admission_policy_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "output_critic_version": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "context_pack_hash": {
          "type": [
            "string",
            "null"
          ]
        },
        "profile_snapshot_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "correction_revision": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "decision_code": {
          "type": [
            "string",
            "null"
          ]
        },
        "reason_codes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "allowed": {
          "type": [
            "boolean",
            "null"
          ]
        }
      }
    },
    "redaction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "raw_payload_stored"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "redacted",
            "hash_only",
            "raw_allowed",
            "blocked"
          ]
        },
        "raw_payload_stored": {
          "type": "boolean"
        },
        "redaction_policy_version": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "payload_hash": {
      "type": "string"
    },
    "payload_redacted": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    }
  }
}
