+    def _load_show_background_review_in_chat() -> bool:
+        """Load show_background_review_in_chat toggle from config.yaml display section.
+
+        Defaults to False — background review messages are internal and should
+        not surface in subject-facing messaging platform chats.
+        """
+        try:
+            import yaml as _y
+            cfg_path = _hermes_home / "config.yaml"
+            if cfg_path.exists():
