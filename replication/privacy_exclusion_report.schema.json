{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://relic-oss.github.io/schemas/privacy_exclusion_report.schema.json",
  "title": "Privacy Exclusion Report",
  "description": "Documents all items excluded from replication bundles for privacy reasons. Required for every bundle to ensure transparency about what is not included.",
  "type": "object",
  "required": [
    "report_version",
    "generated_at",
    "bundle_ref",
    "exclusions"
  ],
  "properties": {
    "report_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Schema version for this exclusion report"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of report generation"
    },
    "bundle_ref": {
      "type": "string",
      "description": "Reference to the bundle this report documents"
    },
    "bundle_type": {
      "type": "string",
      "enum": ["replication", "debug"],
      "description": "Type of bundle this report documents"
    },
    "exclusions": {
      "type": "array",
      "description": "List of all excluded items",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["excluded_item", "exclusion_reason", "category"],
        "properties": {
          "excluded_item": {
            "type": "string",
            "description": "Path or description of the excluded item"
          },
          "exclusion_reason": {
            "type": "string",
            "enum": [
              "contains_raw_private_data",
              "raw_prompt_excluded",
              "raw_provider_store_excluded",
              "raw_session_excluded",
              "sealed_local_replay",
              "user_consent_required",
              "raw_final_prompt_log_excluded",
              "private_memory_excluded",
              "raw_diary_excluded",
              "api_key_excluded"
            ],
            "description": "Reason for exclusion"
          },
          "category": {
            "type": "string",
            "enum": [
              "raw_prompt",
              "provider_store",
              "session_transcript",
              "sealed_replay",
              "private_memory",
              "diary_world_state",
              "credentials",
              "final_prompt_log"
            ],
            "description": "Category of excluded data"
          },
          "privacy_rationale": {
            "type": "string",
            "description": "Explanation of why this exclusion protects privacy"
          },
          "would_have_affected": {
            "type": "array",
            "description": "What reproducibility aspects this exclusion affects",
            "items": {"type": "string"}
          },
          "synthetic_equivalent_available": {
            "type": "boolean",
            "default": false
          },
          "synthetic_equivalent_path": {
            "type": "string",
            "description": "Path to synthetic equivalent fixture if available"
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "description": "Summary statistics of exclusions",
      "properties": {
        "total_exclusions": {
          "type": "integer",
          "minimum": 0
        },
        "raw_prompt_exclusions": {
          "type": "integer",
          "minimum": 0
        },
        "sealed_replay_exclusions": {
          "type": "integer",
          "minimum": 0
        },
        "private_memory_exclusions": {
          "type": "integer",
          "minimum": 0
        },
        "credential_exclusions": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "privacy_checks_performed": {
      "type": "array",
      "description": "List of privacy checks that were performed",
      "items": {
        "type": "object",
        "properties": {
          "check_name": {"type": "string"},
          "check_passed": {"type": "boolean"},
          "check_output": {"type": "string"}
        }
      }
    },
    "reproducibility_impact": {
      "type": "object",
      "description": "Impact of exclusions on reproducibility",
      "properties": {
        "reproducibility_class": {
          "type": "string",
          "enum": ["exact", "semantic", "statistical", "not_reproducible"]
        },
        "impacted_aspects": {
          "type": "array",
          "items": {"type": "string"}
        },
        "workaround_available": {
          "type": "boolean"
        },
        "workaround_description": {
          "type": "string"
        }
      }
    },
    "compliance": {
      "type": "object",
      "description": "Privacy compliance declarations",
      "properties": {
        "gdpr_compliant": {
          "type": "boolean"
        },
        "ccpa_compliant": {
          "type": "boolean"
        },
        "no_raw_pii_exported": {
          "type": "boolean"
        },
        "consent_documented": {
          "type": "boolean"
        }
      }
    }
  },
  "additionalProperties": true
}
